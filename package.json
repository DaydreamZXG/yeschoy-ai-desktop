{
  "name": "yeschoy-desktop",
  "version": "0.5.1",
  "description": "Official beginner-friendly desktop assistant for 野菜API",
  "type": "module",
  "scripts": {
    "dev": "pnpm tauri dev",
    "build": "pnpm tauri build",
    "tauri": "tauri",
    "dev:renderer": "vite --host 127.0.0.1 --port 1420",
    "build:renderer": "vite build",
    "build:connect": "vite build --config connect/vite.config.mjs",
    "build:download": "vite build --config download/vite.config.mjs",
    "build:candidate": "pnpm tauri build --config src-tauri/tauri.candidate.conf.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,json}\"",
    "test:unit": "vitest run src connect download --exclude 'release/**' --exclude 'work/**' --exclude 'tests/**'",
    "test:unit:watch": "vitest watch",
    "verify:catalog": "node scripts/qa/verify-model-catalog.mjs"
  },
  "keywords": [],
  "author": "YesChoy",
  "license": "MIT",
  "packageManager": "pnpm@10.12.3",
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "code-inspector-plugin": "^1.3.3",
    "cross-fetch": "^4.1.0",
    "jsdom": "^25.0.0",
    "msw": "^2.11.6",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "typescript": "^5.3.0",
    "vite": "^7.3.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.3",
    "@tauri-apps/api": "2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.5.2",
    "lucide-react": "^0.542.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.0.0",
    "sonner": "^2.0.7"
  }
}
