diff --git a/frontend/src/views/user/DesktopConnectView.vue b/frontend/src/views/user/DesktopConnectView.vue
new file mode 100644
index 000000000..54f0b5bc8
--- /dev/null
+++ b/frontend/src/views/user/DesktopConnectView.vue
@@ -0,0 +1,54 @@
+<template>
+  <AppLayout>
+    <div class="mx-auto max-w-xl">
+      <div class="card p-6 text-center">
+        <h1 class="text-lg font-semibold text-gray-900 dark:text-white">{{ t('desktopConnect.title') }}</h1>
+        <p class="mt-2 text-sm text-gray-500 dark:text-dark-400">{{ t('desktopConnect.description') }}</p>
+        <button type="button" class="btn btn-primary mt-6" :disabled="handingOver" @click="connectApp">
+          {{ handingOver ? t('desktopConnect.connecting') : t('desktopConnect.connect') }}
+        </button>
+        <p v-if="handedOver" class="mt-4 text-sm text-gray-500 dark:text-dark-400">{{ t('desktopConnect.handedOver') }}</p>
+      </div>
+    </div>
+  </AppLayout>
+</template>
+
+<script setup lang="ts">
+import { onMounted, ref } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { useRoute, useRouter } from 'vue-router'
+import AppLayout from '@/components/layout/AppLayout.vue'
+import { useAppStore } from '@/stores/app'
+import { issueConnectCode, openDesktopApp, stationOrigin } from '@/api/desktop'
+
+const { t } = useI18n()
+const appStore = useAppStore()
+const route = useRoute()
+const router = useRouter()
+const handingOver = ref(false)
+const handedOver = ref(false)
+
+async function connectApp() {
+  if (!stationOrigin().startsWith('https://')) {
+    appStore.showError(t('desktopConnect.needsHttps'))
+    return
+  }
+  handingOver.value = true
+  try {
+    openDesktopApp(await issueConnectCode())
+    handedOver.value = true
+  } catch {
+    appStore.showError(t('desktopConnect.failed'))
+  } finally {
+    handingOver.value = false
+  }
+}
+
+// The desktop app opens /desktop/connect?auto=1: hand over without another click.
+// The flag is dropped so reloading the page does not hand over again.
+onMounted(() => {
+  if (route.query.auto !== '1') return
+  void router.replace({ path: route.path, query: { ...route.query, auto: undefined } })
+  void connectApp()
+})
+</script>
