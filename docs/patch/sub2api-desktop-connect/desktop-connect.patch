index 000000000..6dd95c2d9
--- /dev/null
+++ b/backend/internal/server/routes/desktop.go
@@ -0,0 +1,55 @@
+package routes
+
+import (
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/handler"
+	"github.com/Wei-Shaw/sub2api/internal/middleware"
+	servermiddleware "github.com/Wei-Shaw/sub2api/internal/server/middleware"
+	"github.com/Wei-Shaw/sub2api/internal/service"
+
+	"github.com/gin-gonic/gin"
+	"github.com/redis/go-redis/v9"
+)
+
+// RegisterDesktopRoutes 注册桌面助手“一键连接”协议的站点侧接口。
+// 路径由桌面助手的公开协议规定，所以不在 /api/v1 下。
+func RegisterDesktopRoutes(r *gin.Engine, h *handler.Handlers, jwtAuth servermiddleware.JWTAuthMiddleware, redisClient *redis.Client, settingService *service.SettingService, panelRateLimiter *servermiddleware.PanelRateLimiter) {
+	rateLimiter := middleware.NewRateLimiter(redisClient)
+	desktop := r.Group("/api/desktop/v2")
+	desktop.Use(h.Desktop.ProtocolErrors)
+
+	// 换取会话：由桌面助手调用，无登录态，凭一次性连接码。
+	desktop.POST("/connect-codes/exchange", rateLimiter.LimitWithOptions("desktop-connect-exchange", 20, time.Minute, middleware.RateLimitOptions{
+		FailureMode: middleware.RateLimitFailClose,
+	}), h.Desktop.ExchangeConnectCode)
+
+	// 站点自述：桌面助手靠它认出这个站支持授权连接，以及各接口在哪。
+	desktop.GET("/bootstrap", h.Desktop.Bootstrap)
+	// 续登录：凭 refresh token，无登录态。
+	desktop.POST("/sessions/refresh", rateLimiter.LimitWithOptions("desktop-session-refresh", 30, time.Minute, middleware.RateLimitOptions{
+		FailureMode: middleware.RateLimitFailClose,
+	}), h.Desktop.RefreshSession)
+
+	signedIn := desktop.Group("")
+	signedIn.Use(gin.HandlerFunc(jwtAuth))
+	// 退出登录始终可用；其余接口在后端模式下只对管理员开放，与 /api/v1 的用户接口一致。
+	signedIn.DELETE("/sessions/current", h.Desktop.EndSession)
+	signedIn.Use(servermiddleware.BackendModeUserGuard(settingService))
+	signedIn.GET("/account", h.Desktop.Account)
+	// 方案要读渠道、分组并逐个解析价格，同样按重查询限流。
+	signedIn.GET("/plans", panelRateLimiter.Heavy(), h.Desktop.Plans)
+	signedIn.GET("/keys", h.Desktop.ListKeys)
+	signedIn.POST("/keys", rateLimiter.LimitWithOptions("desktop-key-create", 30, time.Minute, middleware.RateLimitOptions{
+		FailureMode: middleware.RateLimitFailClose,
+	}), h.Desktop.CreateKey)
+	signedIn.POST("/keys/:id/reveal", h.Desktop.RevealKey)
+	signedIn.DELETE("/keys/:id", h.Desktop.DeleteKey)
+	// 用量是重查询，与 /api/v1/usage 一样叠加按用户限流。
+	signedIn.GET("/usage/summary", panelRateLimiter.Heavy(), h.Desktop.UsageSummary)
+	signedIn.GET("/usage/records", panelRateLimiter.Heavy(), h.Desktop.UsageRecords)
+	signedIn.GET("/notices", h.Desktop.Notices)
+	signedIn.POST("/connect-codes", rateLimiter.LimitWithOptions("desktop-connect-issue", 20, time.Minute, middleware.RateLimitOptions{
+		FailureMode: middleware.RateLimitFailClose,
+	}), h.Desktop.IssueConnectCode)
+}
diff --git a/backend/internal/service/desktop_connect.go b/backend/internal/service/desktop_connect.go
new file mode 100644
index 000000000..8bbb91bea
--- /dev/null
+++ b/backend/internal/service/desktop_connect.go
@@ -0,0 +1,173 @@
+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"net"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// 桌面助手“一键连接”的站点侧实现，接口形状遵循桌面助手公开的
+// station-connect 协议（见 yeschoy-ai-desktop/docs/station-connect-api.openapi.yaml）。
+
+const (
+	// DesktopConnectCodeTTL 是一次性连接码的有效期，协议要求不超过 300 秒。
+	DesktopConnectCodeTTL = 300 * time.Second
+)
+
+var (
+	ErrDesktopOriginInvalid   = errors.New("connect_origin_invalid")
+	ErrDesktopCodeExpired     = errors.New("connect_code_expired")
+	ErrDesktopCodeAlreadyUsed = errors.New("connect_code_already_used")
+	ErrDesktopOriginMismatch  = errors.New("connect_origin_mismatch")
+	ErrDesktopBackendMode     = errors.New("backend_mode")
+)
+
+// DesktopConnectCode is what a one-time code resolves to.
+type DesktopConnectCode struct {
+	UserID int64  `json:"user_id"`
+	Origin string `json:"origin"`
+	// The user's token version when the code was issued: a password change revokes the code
+	// together with the session that asked for it.
+	TokenVersion int64 `json:"token_version"`
+}
+
+// DesktopConnectCodeStore keeps one-time codes; Consume must hand a code to exactly one caller.
+type DesktopConnectCodeStore interface {
+	Save(ctx context.Context, codeHash string, code DesktopConnectCode, ttl time.Duration) error
+	// Consume returns ErrDesktopCodeAlreadyUsed for a code that was consumed before and
+	// ErrDesktopCodeExpired for an unknown or expired one.
+	Consume(ctx context.Context, codeHash string) (*DesktopConnectCode, error)
+}
+
+type DesktopIssuedCode struct {
+	Code      string
+	Origin    string
+	ExpiresAt time.Time
+}
+
+type DesktopAuthBundle struct {
+	AccessToken      string
+	RefreshToken     string
+	SessionID        string
+	AccessExpiresAt  time.Time
+	RefreshExpiresAt time.Time
+}
+
+type DesktopConnectService struct {
+	codes       DesktopConnectCodeStore
+	userRepo    UserRepository
+	authService *AuthService
+}
+
+func NewDesktopConnectService(codes DesktopConnectCodeStore, userRepo UserRepository, authService *AuthService) *DesktopConnectService {
+	return &DesktopConnectService{codes: codes, userRepo: userRepo, authService: authService}
+}
+
+// CanonicalDesktopOrigin validates an origin against the protocol: https only, no userinfo,
+// no explicit port, no path/query/fragment, and a DNS host name rather than an IP literal.
+func CanonicalDesktopOrigin(raw string) (string, error) {
+	parsed, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil || parsed.Scheme != "https" || parsed.User != nil || parsed.Port() != "" ||
+		parsed.RawQuery != "" || parsed.Fragment != "" || (parsed.Path != "" && parsed.Path != "/") {
+		return "", ErrDesktopOriginInvalid
+	}
+	host := strings.ToLower(parsed.Hostname())
+	if host == "" || net.ParseIP(host) != nil {
+		return "", ErrDesktopOriginInvalid
+	}
+	return "https://" + host, nil
+}
+
+func randomURLSafeToken() (string, error) {
+	buf := make([]byte, 32)
+	if _, err := rand.Read(buf); err != nil {
+		return "", err
+	}
+	return base64.RawURLEncoding.EncodeToString(buf), nil
+}
+
+func hashDesktopSecret(secret string) string {
+	sum := sha256.Sum256([]byte(secret))
+	return hex.EncodeToString(sum[:])
+}
+
+// IssueCode creates a one-time code for the signed-in user, bound to the station origin.
+func (s *DesktopConnectService) IssueCode(ctx context.Context, userID int64, origin string) (*DesktopIssuedCode, error) {
+	canonical, err := CanonicalDesktopOrigin(origin)
+	if err != nil {
+		return nil, err
+	}
+	user, err := s.userRepo.GetByID(ctx, userID)
+	if err != nil {
+		return nil, err
+	}
+	code, err := randomURLSafeToken()
+	if err != nil {
+		return nil, err
+	}
+	issued := DesktopConnectCode{UserID: userID, Origin: canonical, TokenVersion: resolvedTokenVersion(user)}
+	if err := s.codes.Save(ctx, hashDesktopSecret(code), issued, DesktopConnectCodeTTL); err != nil {
+		return nil, err
+	}
+	return &DesktopIssuedCode{Code: code, Origin: canonical, ExpiresAt: time.Now().Add(DesktopConnectCodeTTL)}, nil
+}
+
+// Exchange turns a one-time code into a normal sign-in session for the desktop app.
+// requestHost is the Host the app actually called; it must be the host the code was issued for.
+// adminOnly is the station's backend mode at exchange time: a code issued before it was switched on
+// must not sign a regular user in.
+func (s *DesktopConnectService) Exchange(ctx context.Context, code, requestHost string, adminOnly bool) (*DesktopAuthBundle, error) {
+	issued, err := s.codes.Consume(ctx, hashDesktopSecret(code))
+	if err != nil {
+		return nil, err
+	}
+	host := strings.ToLower(requestHost)
+	if h, _, splitErr := net.SplitHostPort(host); splitErr == nil {
+		host = h
+	}
+	if "https://"+host != issued.Origin {
+		return nil, ErrDesktopOriginMismatch
+	}
+	user, err := s.userRepo.GetByID(ctx, issued.UserID)
+	if err != nil {
+		return nil, err
+	}
+	if !user.IsActive() {
+		return nil, ErrUserNotActive
+	}
+	if adminOnly && !user.IsAdmin() {
+		return nil, ErrDesktopBackendMode
+	}
+	if issued.TokenVersion != resolvedTokenVersion(user) {
+		return nil, ErrDesktopCodeExpired
+	}
+	sessionBytes := make([]byte, 16)
+	if _, err := rand.Read(sessionBytes); err != nil {
+		return nil, err
+	}
+	sessionID := hex.EncodeToString(sessionBytes)
+	pair, err := s.authService.GenerateTokenPair(ctx, user, sessionID)
+	if err != nil {
+		return nil, err
+	}
+	now := time.Now()
+	return &DesktopAuthBundle{
+		AccessToken:      pair.AccessToken,
+		RefreshToken:     pair.RefreshToken,
+		SessionID:        sessionID,
+		AccessExpiresAt:  now.Add(time.Duration(pair.ExpiresIn) * time.Second),
+		RefreshExpiresAt: now.Add(s.authService.RefreshTokenTTL()),
+	}, nil
+}
+
+// RefreshTokenTTL is how long a refresh token issued now stays valid.
+func (s *AuthService) RefreshTokenTTL() time.Duration {
+	return time.Duration(s.cfg.JWT.RefreshTokenExpireDays) * 24 * time.Hour
+}
diff --git a/backend/internal/service/desktop_connect_test.go b/backend/internal/service/desktop_connect_test.go
new file mode 100644
index 000000000..fc1d9d2b2
--- /dev/null
+++ b/backend/internal/service/desktop_connect_test.go
@@ -0,0 +1,130 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+type fakeDesktopCodeStore struct {
+	codes map[string]DesktopConnectCode
+	used  map[string]bool
+}
+
+func newFakeDesktopCodeStore() *fakeDesktopCodeStore {
+	return &fakeDesktopCodeStore{codes: map[string]DesktopConnectCode{}, used: map[string]bool{}}
+}
+
+func (s *fakeDesktopCodeStore) Save(_ context.Context, codeHash string, code DesktopConnectCode, _ time.Duration) error {
+	s.codes[codeHash] = code
+	return nil
+}
+
+func (s *fakeDesktopCodeStore) Consume(_ context.Context, codeHash string) (*DesktopConnectCode, error) {
+	if code, ok := s.codes[codeHash]; ok {
+		delete(s.codes, codeHash)
+		s.used[codeHash] = true
+		return &code, nil
+	}
+	if s.used[codeHash] {
+		return nil, ErrDesktopCodeAlreadyUsed
+	}
+	return nil, ErrDesktopCodeExpired
+}
+
+func TestCanonicalDesktopOrigin(t *testing.T) {
+	valid := map[string]string{
+		"https://yeschoy.com":  "https://yeschoy.com",
+		"https://YesChoy.com/": "https://yeschoy.com",
+	}
+	for in, want := range valid {
+		got, err := CanonicalDesktopOrigin(in)
+		if err != nil || got != want {
+			t.Errorf("CanonicalDesktopOrigin(%q) = %q, %v; want %q", in, got, err, want)
+		}
+	}
+	invalid := []string{
+		"", "http://yeschoy.com", "https://user:pw@yeschoy.com", "https://yeschoy.com:443", "https://yeschoy.com:8443",
+		"https://yeschoy.com/path", "https://yeschoy.com?x=1", "https://yeschoy.com#frag", "https://127.0.0.1", "https://[::1]", "yeschoy.com",
+	}
+	for _, in := range invalid {
+		if _, err := CanonicalDesktopOrigin(in); !errors.Is(err, ErrDesktopOriginInvalid) {
+			t.Errorf("CanonicalDesktopOrigin(%q) error = %v; want ErrDesktopOriginInvalid", in, err)
+		}
+	}
+}
+
+type fakeDesktopUserRepo struct {
+	UserRepository
+	users map[int64]*User
+}
+
+func (r *fakeDesktopUserRepo) GetByID(_ context.Context, id int64) (*User, error) {
+	user, ok := r.users[id]
+	if !ok {
+		return nil, ErrUserNotFound
+	}
+	return user, nil
+}
+
+func newFakeDesktopUserRepo() *fakeDesktopUserRepo {
+	return &fakeDesktopUserRepo{users: map[int64]*User{
+		7: {ID: 7, Email: "u7@example.com", PasswordHash: "hash-before", Status: StatusActive},
+	}}
+}
+
+func TestDesktopConnectIssueCodeRejectsInvalidOrigin(t *testing.T) {
+	svc := NewDesktopConnectService(newFakeDesktopCodeStore(), nil, nil)
+	if _, err := svc.IssueCode(context.Background(), 1, "http://yeschoy.com"); !errors.Is(err, ErrDesktopOriginInvalid) {
+		t.Fatalf("IssueCode error = %v; want ErrDesktopOriginInvalid", err)
+	}
+}
+
+// A code asked for before a password change must not sign anyone in after it.
+func TestDesktopConnectExchangeRejectsCodeIssuedBeforePasswordChange(t *testing.T) {
+	users := newFakeDesktopUserRepo()
+	svc := NewDesktopConnectService(newFakeDesktopCodeStore(), users, nil)
+	ctx := context.Background()
+	issued, err := svc.IssueCode(ctx, 7, "https://yeschoy.com")
+	if err != nil {
+		t.Fatalf("IssueCode: %v", err)
+	}
+	users.users[7].PasswordHash = "hash-after"
+	if _, err := svc.Exchange(ctx, issued.Code, "yeschoy.com", false); !errors.Is(err, ErrDesktopCodeExpired) {
+		t.Fatalf("Exchange after a password change error = %v; want ErrDesktopCodeExpired", err)
+	}
+}
+
+func TestDesktopConnectExchangeRejectsWrongHostAndBurnsTheCode(t *testing.T) {
+	svc := NewDesktopConnectService(newFakeDesktopCodeStore(), newFakeDesktopUserRepo(), nil)
+	ctx := context.Background()
+	issued, err := svc.IssueCode(ctx, 7, "https://yeschoy.com")
+	if err != nil {
+		t.Fatalf("IssueCode: %v", err)
+	}
+	if len(issued.Code) < 32 || issued.Origin != "https://yeschoy.com" {
+		t.Fatalf("issued = %+v", issued)
+	}
+	if _, err := svc.Exchange(ctx, issued.Code, "evil.example:443", false); !errors.Is(err, ErrDesktopOriginMismatch) {
+		t.Fatalf("Exchange on another host error = %v; want ErrDesktopOriginMismatch", err)
+	}
+	if _, err := svc.Exchange(ctx, issued.Code, "yeschoy.com", false); !errors.Is(err, ErrDesktopCodeAlreadyUsed) {
+		t.Fatalf("second Exchange error = %v; want ErrDesktopCodeAlreadyUsed", err)
+	}
+	if _, err := svc.Exchange(ctx, "never-issued-code-never-issued-code-0000", "yeschoy.com", false); !errors.Is(err, ErrDesktopCodeExpired) {
+		t.Fatalf("unknown code error = %v; want ErrDesktopCodeExpired", err)
+	}
+}
+
+func TestDesktopConnectExchangeRefusesRegularUsersInBackendMode(t *testing.T) {
+	svc := NewDesktopConnectService(newFakeDesktopCodeStore(), newFakeDesktopUserRepo(), nil)
+	ctx := context.Background()
+	issued, err := svc.IssueCode(ctx, 7, "https://yeschoy.com")
+	if err != nil {
+		t.Fatalf("IssueCode: %v", err)
+	}
+	if _, err := svc.Exchange(ctx, issued.Code, "yeschoy.com", true); !errors.Is(err, ErrDesktopBackendMode) {
+		t.Fatalf("Exchange in backend mode error = %v; want ErrDesktopBackendMode", err)
+	}
+}
