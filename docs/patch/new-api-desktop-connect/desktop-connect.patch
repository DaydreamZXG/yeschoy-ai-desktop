+func TestDesktopPlansPriceWhatTheAccountPays(t *testing.T) {
+	setupDesktopConnect(t)
+	cacheRead := 0.1
+	pricings := []model.Pricing{
+		{ModelName: "text-model", ModelRatio: 1.5, CompletionRatio: 5, CacheRatio: &cacheRead, EnableGroup: []string{"default", "vip", "staff"}},
+		{ModelName: "image-model", QuotaType: 1, ModelPrice: 0.04, EnableGroup: []string{"vip"}},
+		{ModelName: "tiered-model", BillingMode: "tiered_expr", EnableGroup: []string{"vip"}},
+	}
+
+	plans := desktopPlansForGroup("default", pricings, desktopMoney{Currency: "CNY", Rate: 7})
+	// "staff" has a ratio but is not open to this user; "auto" is never a plan.
+	require.Len(t, plans, 2)
+	assert.Equal(t, "default", plans[0].ID)
+	assert.Equal(t, "Standard", plans[0].Description)
+	require.Len(t, plans[0].Models, 1)
+	assert.Equal(t, 21.0, *plans[0].Models[0].Price.Input)
+
+	vip := plans[1]
+	assert.Equal(t, "vip", vip.ID)
+	assert.False(t, vip.Subscription)
+	assert.False(t, vip.AppOnly)
+	require.Len(t, vip.Models, 3)
+	image, text, tiered := vip.Models[0], vip.Models[1], vip.Models[2]
+	// 1.5 × 2 USD per million tokens × 7 CNY, at half price on this plan.
+	assert.Equal(t, 10.5, *text.Price.Input)
+	assert.Equal(t, 52.5, *text.Price.Output)
+	assert.Equal(t, 1.05, *text.Price.CacheRead)
+	assert.Nil(t, text.Price.CacheWrite)
+	assert.Equal(t, 21.0, *text.Official.Input)
+	assert.Equal(t, 0.14, *image.Price.PerRequest)
+	assert.Nil(t, image.Price.Input)
+	// An expression-billed model is listed, without a price the station cannot state.
+	assert.Equal(t, "tiered-model", tiered.ID)
+	assert.Nil(t, tiered.Price)
+	assert.Nil(t, tiered.Official)
+}
