+// DesktopBootstrap handles GET /api/desktop/v2/bootstrap (no sign-in).
+func DesktopBootstrap(c *gin.Context) {
+	origin, ok := desktopConnectOrigin(c)
+	if !ok {
+		desktopError(c, http.StatusBadRequest, "connect_origin_invalid")
+		return
+	}
+	desktopOK(c, gin.H{
+		"schema_version":                 2,
+		"service":                        desktopConnectService,
+		"contract_id":                    desktopConnectContractID,
+		"minimum_client_version":         "0.0.0",
+		"device_authorization_available": false,
+		"oauth_loopback_pkce_available":  false,
+		"account_read":                   true,
+		"usage_read":                     true,
+		"models_read":                    true,
+		"pricing_read":                   true,
+		"tool_keys_manage":               true,
+		"session_refresh_path":           desktopConnectBasePath + "/sessions/refresh",
+		"session_logout_path":            desktopConnectBasePath + "/sessions/current",
+		"account_path":                   desktopConnectBasePath + "/account",
+		"plans_path":                     desktopConnectBasePath + "/plans",
+		"keys_path":                      desktopConnectBasePath + "/keys",
+		"usage_summary_path":             desktopConnectBasePath + "/usage/summary",
+		"usage_records_path":             desktopConnectBasePath + "/usage/records",
+		"announcements_path":             desktopConnectBasePath + "/notices",
+		"wallet_url":                     origin + "/wallet",
+	})
+}
