+// DesktopIssueConnectCode handles POST /api/desktop/v2/connect-codes. Only a
+// browser login session may ask for a code: an access token must not be able
+// to turn itself into a login session.
+func DesktopIssueConnectCode(c *gin.Context) {
+	identity, ok := middleware.GetSessionAuthIdentity(c)
+	if !ok {
+		desktopError(c, http.StatusForbidden, "session_required")
+		return
+	}
+	// A desktop session must not mint further sessions: revoking it has to end
+	// what it could reach.
+	session, err := model.GetUserSessionCached(identity.SessionID)
+	if err != nil || session.LoginMethod == desktopConnectLoginLabel {
+		desktopError(c, http.StatusForbidden, "session_required")
+		return
+	}
+	origin, ok := desktopConnectOrigin(c)
+	if !ok {
+		desktopError(c, http.StatusBadRequest, "connect_origin_invalid")
+		return
+	}
+	var request struct {
+		Origin string `json:"origin"`
+	}
+	if c.Request.ContentLength != 0 {
+		if err := common.DecodeJson(c.Request.Body, &request); err != nil {
+			desktopError(c, http.StatusBadRequest, "invalid_request")
+			return
+		}
+	}
+	if request.Origin != "" {
+		if requested, err := common.NormalizeOrigin(request.Origin); err != nil || requested != origin {
+			desktopError(c, http.StatusBadRequest, "connect_origin_mismatch")
+			return
+		}
+	}
+	secret := make([]byte, 32)
+	if _, err := rand.Read(secret); err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	code := base64.RawURLEncoding.EncodeToString(secret)
+	grant := desktopConnectGrant{UserID: identity.UserID, AuthVersion: identity.UserAuthVersion, Origin: origin}
+	if err := storeDesktopConnectCode(code, grant); err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	desktopOK(c, gin.H{
+		"code":       code,
+		"origin":     origin,
+		"expiresAt":  time.Now().Add(desktopConnectCodeTTL).Unix(),
+		"ttlSeconds": int(desktopConnectCodeTTL.Seconds()),
+	})
+}
+
+// DesktopExchangeConnectCode handles POST /api/desktop/v2/connect-codes/exchange.
+// The code is spent before anything else is checked, so a code that was seen
+// once can never be tried again. The session it opens is an ordinary login
+// session labelled "desktop": the user sees it in the session list and can
+// revoke it there.
+func DesktopExchangeConnectCode(c *gin.Context) {
+	var request struct {
+		Code string `json:"code"`
+	}
+	if err := common.DecodeJson(c.Request.Body, &request); err != nil || len(request.Code) < 32 || len(request.Code) > 512 {
+		desktopError(c, http.StatusBadRequest, "invalid_request")
+		return
+	}
+	grant, err := consumeDesktopConnectCode(request.Code)
+	switch {
+	case errors.Is(err, errDesktopConnectCodeExpired):
+		desktopError(c, http.StatusBadRequest, "connect_code_expired")
+		return
+	case errors.Is(err, errDesktopConnectCodeUsed):
+		desktopError(c, http.StatusBadRequest, "connect_code_already_used")
+		return
+	case err != nil:
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	if origin, ok := desktopConnectOrigin(c); !ok || origin != grant.Origin {
+		desktopError(c, http.StatusBadRequest, "connect_origin_mismatch")
+		return
+	}
+	bundle, err := service.CreateLoginSessionAtAuthVersion(grant.UserID, grant.AuthVersion, desktopConnectLoginLabel, c.ClientIP(), c.Request.UserAgent())
+	switch {
+	case errors.Is(err, model.ErrUserSessionLimit):
+		desktopError(c, http.StatusConflict, "session_limit_reached")
+		return
+	case errors.Is(err, model.ErrUserSessionIssuanceLimit):
+		desktopError(c, http.StatusTooManyRequests, "rate_limited")
+		return
+	case errors.Is(err, service.ErrLoginSessionInvalid), errors.Is(err, service.ErrLoginSessionRevoked):
+		// The account was disabled or its credentials changed after the code was issued.
+		desktopError(c, http.StatusBadRequest, "connect_code_expired")
+		return
+	case err != nil:
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	if user, err := model.GetUserCache(grant.UserID); err == nil {
+		model.RecordLoginLog(user.Id, user.Role, user.Username, "Logged in successfully via "+desktopConnectLoginLabel, c.ClientIP(), "login",
+			map[string]any{"method": desktopConnectLoginLabel},
+			model.AuditOther{LoginMethod: desktopConnectLoginLabel, UserAgent: c.Request.UserAgent()}, c)
+	}
+	desktopOK(c, gin.H{
+		"accessToken":      bundle.AccessToken,
+		"tokenType":        bundle.TokenType,
+		"accessExpiresAt":  bundle.AccessExpiresAt,
+		"refreshToken":     bundle.RefreshToken,
+		"refreshExpiresAt": bundle.Session.ExpiresAt,
+		"sessionId":        bundle.Session.SID,
+	})
+}
+
+// DesktopRefreshSession handles POST /api/desktop/v2/sessions/refresh. A client
+// signs the user out on 401, so 401 is kept for a session that is really over.
+func DesktopRefreshSession(c *gin.Context) {
+	var request struct {
+		RefreshToken string `json:"refresh_token"`
+		SessionID    string `json:"session_id"`
+	}
+	if err := common.DecodeJson(c.Request.Body, &request); err != nil || request.RefreshToken == "" || request.SessionID == "" {
+		desktopError(c, http.StatusBadRequest, "invalid_request")
+		return
+	}
+	bundle, _, err := service.RefreshLoginSession(request.RefreshToken, request.SessionID, c.ClientIP(), c.Request.UserAgent())
+	switch {
+	case errors.Is(err, service.ErrRefreshTokenInvalid), errors.Is(err, service.ErrLoginSessionRevoked), errors.Is(err, service.ErrLoginSessionMismatch):
+		desktopError(c, http.StatusUnauthorized, "session_expired")
+		return
+	case errors.Is(err, service.ErrRefreshRace):
+		desktopError(c, http.StatusConflict, "refresh_in_progress")
+		return
+	case err != nil:
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	desktopOK(c, gin.H{
+		"access_token":       bundle.AccessToken,
+		"token_type":         bundle.TokenType,
+		"access_expires_at":  bundle.AccessExpiresAt,
+		"refresh_token":      bundle.RefreshToken,
+		"refresh_expires_at": bundle.Session.ExpiresAt,
+		"session_id":         bundle.Session.SID,
+	})
+}
+
+// DesktopEndSession handles DELETE /api/desktop/v2/sessions/current.
+func DesktopEndSession(c *gin.Context) {
+	identity, ok := middleware.GetSessionAuthIdentity(c)
+	if !ok {
+		desktopError(c, http.StatusForbidden, "session_required")
+		return
+	}
+	if _, err := model.RevokeUserSession(identity.UserID, identity.SessionID, "logout"); err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	desktopOK(c, gin.H{})
+}
+
+// desktopMoney turns the station's internal amounts into what the user is
+// shown. The contract knows two currencies, so a station that displays a
+// custom unit or raw quota reports US dollars.
+type desktopMoney struct {
+	Currency string
+	Rate     float64
+}
+
+func currentDesktopMoney() desktopMoney {
+	if operation_setting.GetQuotaDisplayType() == operation_setting.QuotaDisplayTypeCNY && operation_setting.USDExchangeRate > 0 {
+		return desktopMoney{Currency: "CNY", Rate: operation_setting.USDExchangeRate}
+	}
+	return desktopMoney{Currency: "USD", Rate: 1}
+}
+
+func (m desktopMoney) fromUSD(usd float64) float64 {
+	return math.Round(usd*m.Rate*1e6) / 1e6
+}
+
+func (m desktopMoney) fromQuota(quota int) float64 {
+	return m.fromUSD(float64(quota) / common.QuotaPerUnit)
+}
+
+type desktopPrice struct {
+	Input      *float64 `json:"input,omitempty"`
+	Output     *float64 `json:"output,omitempty"`
+	CacheRead  *float64 `json:"cacheRead,omitempty"`
+	CacheWrite *float64 `json:"cacheWrite,omitempty"`
+	PerRequest *float64 `json:"perRequest,omitempty"`
+}
+
+type desktopPlanModel struct {
+	ID       string        `json:"id"`
+	Price    *desktopPrice `json:"price,omitempty"`
+	Official *desktopPrice `json:"official,omitempty"`
+}
+
+type desktopPlan struct {
+	ID           string             `json:"id"`
+	Name         string             `json:"name"`
+	Description  string             `json:"description"`
+	Formats      []string           `json:"formats"`
+	Subscription bool               `json:"subscription"`
+	AppOnly      bool               `json:"appOnly"`
+	Models       []desktopPlanModel `json:"models"`
+}
+
+// desktopModelPrice prices one model per million tokens (or per request) at a
+// group ratio. Ratio 1 is the station's list price, which the client shows as
+// the official price. Models billed by an expression or only through plugin
+// variants have no single price to state and return nil.
+func desktopModelPrice(pricing model.Pricing, groupRatio float64, money desktopMoney) *desktopPrice {
+	if pricing.BillingMode != "" || (len(pricing.BillingPluginVariants) > 0 && !pricing.OrdinaryPricing) {
+		return nil
+	}
+	amount := func(usd float64) *float64 {
+		value := money.fromUSD(usd * groupRatio)
+		return &value
+	}
+	if pricing.QuotaType == 1 {
+		return &desktopPrice{PerRequest: amount(pricing.ModelPrice)}
+	}
+	// A model ratio of 1 is 500 quota per 1K tokens: 2 US dollars per million.
+	input := pricing.ModelRatio * 2
+	price := &desktopPrice{Input: amount(input), Output: amount(input * pricing.CompletionRatio)}
+	if pricing.CacheRatio != nil {
+		price.CacheRead = amount(input * *pricing.CacheRatio)
+	}
+	if pricing.CreateCacheRatio != nil {
+		price.CacheWrite = amount(input * *pricing.CreateCacheRatio)
+	}
+	return price
+}
+
+// desktopPlansForGroup lists the groups a user of userGroup may create a key
+// on, each with the models enabled for it. The "auto" group picks a group per
+// request and so has no price of its own; it is not offered as a plan.
+func desktopPlansForGroup(userGroup string, pricings []model.Pricing, money desktopMoney) []desktopPlan {
+	usable := service.GetUserUsableGroups(userGroup)
+	plans := []desktopPlan{}
+	for group := range ratio_setting.GetGroupRatioCopy() {
+		description, ok := usable[group]
+		if !ok || group == "auto" {
+			continue
+		}
+		ratio := service.GetUserGroupRatio(userGroup, group)
+		plan := desktopPlan{
+			ID:          group,
+			Name:        group,
+			Description: description,
+			Formats:     []string{"anthropic", "openai-chat", "openai-responses", "gemini"},
+			Models:      []desktopPlanModel{},
+		}
+		for _, pricing := range pricings {
+			if !slices.Contains(pricing.EnableGroup, group) {
+				continue
+			}
+			plan.Models = append(plan.Models, desktopPlanModel{
+				ID:       pricing.ModelName,
+				Price:    desktopModelPrice(pricing, ratio, money),
+				Official: desktopModelPrice(pricing, 1, money),
+			})
+		}
+		slices.SortFunc(plan.Models, func(a, b desktopPlanModel) int { return strings.Compare(a.ID, b.ID) })
+		plans = append(plans, plan)
+	}
+	slices.SortFunc(plans, func(a, b desktopPlan) int { return strings.Compare(a.ID, b.ID) })
+	return plans
+}
+
+// DesktopAccount handles GET /api/desktop/v2/account.
+func DesktopAccount(c *gin.Context) {
+	user, err := model.GetUserById(c.GetInt("id"), false)
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	money := currentDesktopMoney()
+	desktopOK(c, gin.H{
+		"username":    user.Username,
+		"displayName": user.DisplayName,
+		"email":       user.Email,
+		"currency":    money.Currency,
+		"balance":     money.fromQuota(user.Quota),
+	})
+}
+
+// DesktopPlans handles GET /api/desktop/v2/plans.
+func DesktopPlans(c *gin.Context) {
+	userGroup, err := getTokenRequestUserGroup(c)
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	money := currentDesktopMoney()
+	desktopOK(c, gin.H{"currency": money.Currency, "plans": desktopPlansForGroup(userGroup, model.GetPricing(), money)})
+}
+
+func desktopKeyView(token *model.Token, userGroup string) gin.H {
+	status := "disabled"
+	switch token.Status {
+	case common.TokenStatusEnabled:
+		status = "active"
+	case common.TokenStatusExpired:
+		status = "expired"
+	case common.TokenStatusExhausted:
+		status = "exhausted"
+	}
+	planID := token.Group
+	if planID == "" {
+		planID = userGroup
+	}
+	return gin.H{
+		"id":               strconv.Itoa(token.Id),
+		"name":             token.Name,
+		"planId":           planID,
+		"status":           status,
+		"createdAtEpochMs": token.CreatedTime * 1000,
+	}
+}
+
+// DesktopListKeys handles GET /api/desktop/v2/keys.
+func DesktopListKeys(c *gin.Context) {
+	userGroup, err := getTokenRequestUserGroup(c)
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	tokens, err := model.GetAllUserTokens(c.GetInt("id"), 0, max(operation_setting.GetMaxUserTokens(), 1))
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	keys := make([]gin.H, 0, len(tokens))
+	for _, token := range tokens {
+		keys = append(keys, desktopKeyView(token, userGroup))
+	}
+	desktopOK(c, gin.H{"keys": keys})
+}
+
+// DesktopCreateKey handles POST /api/desktop/v2/keys. The key is unlimited and
+// does not expire, like a key made in the console with the defaults.
+func DesktopCreateKey(c *gin.Context) {
+	var request struct {
+		Name   string `json:"name"`
+		PlanID string `json:"planId"`
+	}
+	if err := common.DecodeJson(c.Request.Body, &request); err != nil {
+		desktopError(c, http.StatusBadRequest, "invalid_request")
+		return
+	}
+	request.Name = strings.TrimSpace(request.Name)
+	if request.Name == "" || len(request.Name) > 50 || request.PlanID == "" {
+		desktopError(c, http.StatusBadRequest, "invalid_request")
+		return
+	}
+	userID := c.GetInt("id")
+	userGroup, err := getTokenRequestUserGroup(c)
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	if request.PlanID == "auto" || !service.GroupInUserUsableGroups(userGroup, request.PlanID) {
+		desktopError(c, http.StatusForbidden, "plan_not_allowed")
+		return
+	}
+	count, err := model.CountUserTokens(userID)
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	if int(count) >= operation_setting.GetMaxUserTokens() {
+		desktopError(c, http.StatusConflict, "key_limit_reached")
+		return
+	}
+	key, err := common.GenerateKey()
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	now := common.GetTimestamp()
+	token := model.Token{
+		UserId:              userID,
+		Name:                request.Name,
+		Key:                 key,
+		CreatedTime:         now,
+		AccessedTime:        now,
+		ExpiredTime:         -1,
+		UnlimitedQuota:      true,
+		Group:               request.PlanID,
+		AllowUserQuotaQuery: true,
+	}
+	if err := token.Insert(); err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	model.RecordOperationAuditLog(userID, c.GetInt("role"), "API token creation", c.ClientIP(), "token.create",
+		map[string]any{"id": token.Id, "name": token.Name, "via": desktopConnectLoginLabel}, nil, nil, c)
+	view := desktopKeyView(&token, userGroup)
+	view["key"] = "sk-" + token.GetFullKey()
+	desktopOK(c, view)
+}
+
+// desktopOwnedKey loads the key in the path if it belongs to the caller.
+func desktopOwnedKey(c *gin.Context) (*model.Token, bool) {
+	id, err := strconv.Atoi(c.Param("id"))
+	if err != nil || id <= 0 {
+		desktopError(c, http.StatusNotFound, "key_not_found")
+		return nil, false
+	}
+	token, err := model.GetTokenByIds(id, c.GetInt("id"))
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		desktopError(c, http.StatusNotFound, "key_not_found")
+		return nil, false
+	}
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return nil, false
+	}
+	return token, true
+}
+
+// DesktopRevealKey handles POST /api/desktop/v2/keys/:id/reveal.
+func DesktopRevealKey(c *gin.Context) {
+	token, ok := desktopOwnedKey(c)
+	if !ok {
+		return
+	}
+	model.RecordOperationAuditLog(token.UserId, c.GetInt("role"), "API token key access", c.ClientIP(), "token.key_view",
+		map[string]any{"id": token.Id, "name": token.Name, "via": desktopConnectLoginLabel}, nil, nil, c)
+	desktopOK(c, gin.H{"key": "sk-" + token.GetFullKey()})
+}
+
+// DesktopDeleteKey handles DELETE /api/desktop/v2/keys/:id.
+func DesktopDeleteKey(c *gin.Context) {
+	token, ok := desktopOwnedKey(c)
+	if !ok {
+		return
+	}
+	if err := model.DeleteTokenById(token.Id, token.UserId); err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	model.RecordOperationAuditLog(token.UserId, c.GetInt("role"), "API token deletion", c.ClientIP(), "token.delete",
+		map[string]any{"id": token.Id, "name": token.Name, "via": desktopConnectLoginLabel}, nil, nil, c)
+	desktopOK(c, gin.H{})
+}
+
+// desktopUsageWindowStart is how far back the desktop reads usage: thirty
+// days, or less if the station keeps a shorter range open to its users.
+func desktopUsageWindowStart() (start int64, days int) {
+	seconds := min(int64(desktopUsageWindowDays*24*60*60), operation_setting.GetLogSetting().MaxRangeSeconds())
+	return common.GetTimestamp() - seconds, int(seconds / (24 * 60 * 60))
+}
+
+// DesktopUsageSummary handles GET /api/desktop/v2/usage/summary.
+func DesktopUsageSummary(c *gin.Context) {
+	start, days := desktopUsageWindowStart()
+	username := c.GetString("username")
+	stat, err := model.SumUsedQuota(model.LogTypeConsume, start, 0, "", username, "", 0, "")
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	_, requests, err := model.GetUserLogs(c.GetInt("id"), model.LogFilter{Type: model.LogTypeConsume, StartTimestamp: start}, 0, 1)
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	money := currentDesktopMoney()
+	desktopOK(c, gin.H{
+		"currency":   money.Currency,
+		"windowDays": days,
+		"consumed":   money.fromQuota(stat.Quota),
+		"requests":   requests,
+		"tokens":     model.SumUsedToken(model.LogTypeConsume, start, 0, "", username, ""),
+	})
+}
+
+// DesktopUsageRecords handles GET /api/desktop/v2/usage/records.
+func DesktopUsageRecords(c *gin.Context) {
+	page, _ := strconv.Atoi(c.Query("page"))
+	page = max(page, 1)
+	pageSize, _ := strconv.Atoi(c.Query("pageSize"))
+	if pageSize <= 0 || pageSize > desktopUsagePageSize {
+		pageSize = desktopUsagePageSize
+	}
+	start, _ := desktopUsageWindowStart()
+	logs, total, err := model.GetUserLogs(c.GetInt("id"), model.LogFilter{Type: model.LogTypeConsume, StartTimestamp: start}, (page-1)*pageSize, pageSize)
+	if err != nil {
+		desktopError(c, http.StatusServiceUnavailable, "service_unavailable")
+		return
+	}
+	money := currentDesktopMoney()
+	records := make([]gin.H, 0, len(logs))
+	for _, log := range logs {
+		var other struct {
+			CacheTokens         int `json:"cache_tokens"`
+			CacheCreationTokens int `json:"cache_creation_tokens"`
+		}
+		_ = common.UnmarshalJsonStr(log.Other, &other)
+		// The list numbers its rows per page; the request id is what stays the same.
+		id := log.RequestId
+		if id == "" {
+			id = strconv.FormatInt(log.CreatedAt, 10) + "-" + strconv.Itoa(log.Id)
+		}
+		records = append(records, gin.H{
+			"id":           id,
+			"atEpochMs":    log.CreatedAt * 1000,
+			"model":        log.ModelName,
+			"planId":       log.Group,
+			"keyId":        strconv.Itoa(log.TokenId),
+			"keyName":      log.TokenName,
+			"inputTokens":  log.PromptTokens,
+			"outputTokens": log.CompletionTokens,
+			"cacheTokens":  other.CacheTokens + other.CacheCreationTokens,
+			"amount":       money.fromQuota(log.Quota),
+		})
+	}
+	desktopOK(c, gin.H{"currency": money.Currency, "records": records, "total": total, "page": page, "pageSize": pageSize})
+}
+
+// DesktopNotices handles GET /api/desktop/v2/notices. Console announcements
+// carry no title, so the first line of the text stands in for one.
+func DesktopNotices(c *gin.Context) {
+	notices := []gin.H{}
+	if !console_setting.GetConsoleSetting().AnnouncementsEnabled {
+		desktopOK(c, gin.H{"notices": notices})
+		return
+	}
+	for _, announcement := range console_setting.GetAnnouncements() {
+		content, _ := announcement["content"].(string)
+		content = strings.TrimSpace(content)
+		if content == "" {
+			continue
+		}
+		publishDate, _ := announcement["publishDate"].(string)
+		var publishedAt int64
+		if published, err := time.Parse(time.RFC3339, publishDate); err == nil {
+			publishedAt = published.UnixMilli()
+		}
+		// The body is what follows the title, unless the title had to be cut.
+		title, body, _ := strings.Cut(content, "\n")
+		title, body = strings.TrimSpace(title), strings.TrimSpace(body)
+		if runes := []rune(title); len(runes) > 40 {
+			title, body = string(runes[:40])+"…", content
+		}
+		if extra, _ := announcement["extra"].(string); strings.TrimSpace(extra) != "" {
+			body = strings.TrimSpace(body + "\n" + strings.TrimSpace(extra))
+		}
+		severity := "info"
+		if kind, _ := announcement["type"].(string); kind == "warning" || kind == "error" {
+			severity = "warning"
+		}
+		sum := sha256.Sum256([]byte(publishDate + "\n" + content))
+		notices = append(notices, gin.H{
+			"id":                 hex.EncodeToString(sum[:8]),
+			"title":              title,
+			"body":               body,
+			"severity":           severity,
+			"publishedAtEpochMs": publishedAt,
+			"expiresAtEpochMs":   0,
+			"banner":             false,
+		})
+	}
+	desktopOK(c, gin.H{"notices": notices})
+}
+
+// desktopConnectPage is the page a desktop client opens to sign in. The
+// dashboard keeps its access token in memory, so the page asks the refresh
+// endpoint for one with the browser's login cookie, the same way a newly
+// opened dashboard tab does, and then requests a connect code.
+const desktopConnectPage = `<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="referrer" content="no-referrer">
+<title>Connect desktop app</title>
+<style>
+body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;font:16px/1.6 system-ui,sans-serif;background:#f6f7f9;color:#1c1f23}
+main{width:min(420px,calc(100vw - 48px));padding:32px;border-radius:16px;background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.08);text-align:center}
+h1{margin:0 0 8px;font-size:20px}
+p{margin:0 0 24px;color:#5b6168}
+button,a.button{display:inline-block;padding:10px 24px;border:0;border-radius:10px;background:#1c1f23;color:#fff;font:inherit;text-decoration:none;cursor:pointer}
+button[disabled]{opacity:.5;cursor:default}
+[hidden]{display:none!important}
+@media (prefers-color-scheme:dark){body{background:#111315;color:#f2f3f5}main{background:#1c1f23}p{color:#a5abb3}button,a.button{background:#f2f3f5;color:#111315}}
+</style>
+</head>
+<body>
+<main>
+<h1 id="title"></h1>
+<p id="text"></p>
+<button id="connect" type="button" hidden></button>
+<a id="login" class="button" href="/sign-in" target="_blank" rel="noopener" hidden></a>
+</main>
+<script nonce="{{nonce}}">
+(function () {
+  var zh = /^zh/i.test(navigator.language || '');
+  var copy = zh ? {
+    title: '连接到桌面应用', ready: '点一下，把这个账号连到你电脑上的桌面应用。', connect: '连接',
+    login: '去登录', signedOut: '请先登录这个站点（会在新标签页打开），登录后回到这一页。', working: '正在连接…',
+    opened: '已经交给桌面应用。没有反应的话，确认应用已经装好，再点一次。', failed: '没连上，请再试一次。'
+  } : {
+    title: 'Connect desktop app', ready: 'Connect this account to the desktop app on this computer.', connect: 'Connect',
+    login: 'Sign in', signedOut: 'Sign in to this site first (it opens in a new tab), then come back to this page.', working: 'Connecting…',
+    opened: 'Handed over to the desktop app. If nothing happened, check that the app is installed and try again.', failed: 'Could not connect. Please try again.'
+  };
+  var text = document.getElementById('text');
+  var button = document.getElementById('connect');
+  var login = document.getElementById('login');
+  document.documentElement.lang = zh ? 'zh' : 'en';
+  document.title = copy.title;
+  document.getElementById('title').textContent = copy.title;
+  button.textContent = copy.connect;
+  login.textContent = copy.login;
+
+  function signedOut() {
+    text.textContent = copy.signedOut;
+    button.hidden = true;
+    login.hidden = false;
+  }
+  function post(path, token) {
+    var headers = { 'Content-Type': 'application/json' };
+    if (token) headers.Authorization = 'Bearer ' + token;
+    return fetch(path, { method: 'POST', credentials: 'same-origin', cache: 'no-store', headers: headers, body: '{}' });
+  }
+  function connect() {
+    busy = true;
+    button.disabled = true;
+    text.textContent = copy.working;
+    post('/api/user/auth/refresh').then(function (response) {
+      if (response.status === 401) { signedOut(); return null; }
+      if (!response.ok) throw new Error('refresh');
+      return response.json();
+    }).then(function (session) {
+      if (!session) return null;
+      return post('/api/desktop/v2/connect-codes', session.data.access_token).then(function (response) {
+        if (!response.ok) throw new Error('code');
+        return response.json();
+      });
+    }).then(function (issued) {
+      if (!issued) return;
+      text.textContent = copy.opened;
+      button.disabled = false;
+      location.href = 'yeschoy://connect?origin=' + encodeURIComponent(issued.data.origin) + '&code=' + encodeURIComponent(issued.data.code);
+    }).catch(function () {
+      text.textContent = copy.failed;
+      button.disabled = false;
+    }).then(function () { busy = false; });
+  }
+
+  // The dashboard is a single-page app and cannot send the browser back here
+  // after sign-in, so sign-in opens in another tab and this page looks again
+  // whenever it is shown.
+  var auto = new URLSearchParams(location.search).get('auto') === '1';
+  var busy = false;
+  if (auto) history.replaceState(null, '', location.pathname);
+  function refresh() {
+    if (busy) return;
+    if (document.cookie.split('; ').indexOf('{{hint}}') < 0) { signedOut(); return; }
+    if (!button.hidden) return;
+    login.hidden = true;
+    button.hidden = false;
+    if (auto) { auto = false; connect(); return; }
+    text.textContent = copy.ready;
+  }
+  button.addEventListener('click', connect);
+  window.addEventListener('focus', refresh);
+  document.addEventListener('visibilitychange', function () { if (!document.hidden) refresh(); });
+  refresh();
+})();
+</script>
+</body>
+</html>
+`
+
+// DesktopConnectPage handles GET /desktop/connect.
+func DesktopConnectPage(c *gin.Context) {
+	secret := make([]byte, 16)
+	if _, err := rand.Read(secret); err != nil {
+		c.AbortWithStatus(http.StatusServiceUnavailable)
+		return
+	}
+	nonce := base64.RawStdEncoding.EncodeToString(secret)
+	page := strings.NewReplacer(
+		"{{nonce}}", nonce,
+		"{{hint}}", service.SessionHintCookieName+"="+service.SessionHintCookieValue,
+	).Replace(desktopConnectPage)
+	c.Header("Cache-Control", "no-store")
+	c.Header("X-Frame-Options", "DENY")
+	c.Header("X-Content-Type-Options", "nosniff")
+	c.Header("Referrer-Policy", "no-referrer")
+	c.Header("Content-Security-Policy", "default-src 'none'; script-src 'nonce-"+nonce+"'; style-src 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'")
+	c.Data(http.StatusOK, "text/html; charset=utf-8", []byte(page))
+}
