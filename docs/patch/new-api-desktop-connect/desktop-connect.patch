+func TestDesktopKeysBelongToTheirOwnerAndAnAllowedPlan(t *testing.T) {
+	router, user, browser := setupDesktopConnect(t)
+	operation_setting.GetTokenSetting().MaxUserTokens = 2
+	stranger := model.Token{UserId: user.Id + 1, Name: "not-yours", Key: strings.Repeat("s", 48), Status: common.TokenStatusEnabled, Group: "default"}
+	require.NoError(t, model.DB.Create(&stranger).Error)
+	create := func(name, plan string) (int, desktopTestReply) {
+		return desktopCall(t, router, http.MethodPost, "/api/desktop/v2/keys", desktopTestHost, browser.AccessToken, `{"name":"`+name+`","planId":"`+plan+`"}`)
+	}
+
+	for _, plan := range []string{"staff", "auto", "missing"} {
+		status, reply := create("app", plan)
+		assert.Equal(t, http.StatusForbidden, status, plan)
+		assert.Equal(t, "plan_not_allowed", reply.Code, plan)
+	}
+
+	status, reply := create("app", "vip")
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	id, _ := reply.Data["id"].(string)
+	secret, _ := reply.Data["key"].(string)
+	assert.Equal(t, "vip", reply.Data["planId"])
+	assert.Equal(t, "active", reply.Data["status"])
+	// The secret is the string the relay accepts as it stands.
+	stored, err := model.GetTokenByIds(mustAtoi(t, id), user.Id)
+	require.NoError(t, err)
+	assert.Equal(t, "sk-"+stored.Key, secret)
+	assert.True(t, stored.UnlimitedQuota)
+
+	status, reply = desktopCall(t, router, http.MethodPost, "/api/desktop/v2/keys/"+id+"/reveal", desktopTestHost, browser.AccessToken, "")
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	assert.Equal(t, secret, reply.Data["key"])
+
+	status, reply = desktopCall(t, router, http.MethodGet, "/api/desktop/v2/keys", desktopTestHost, browser.AccessToken, "")
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	keys, _ := reply.Data["keys"].([]any)
+	require.Len(t, keys, 1)
+	assert.NotContains(t, keys[0], "key")
+
+	_, _ = create("second", "default")
+	status, reply = create("third", "default")
+	assert.Equal(t, http.StatusConflict, status)
+	assert.Equal(t, "key_limit_reached", reply.Code)
+
+	// Another account's key cannot be read or deleted.
+	strangerPath := "/api/desktop/v2/keys/" + strconv.Itoa(stranger.Id)
+	status, reply = desktopCall(t, router, http.MethodPost, strangerPath+"/reveal", desktopTestHost, browser.AccessToken, "")
+	assert.Equal(t, http.StatusNotFound, status)
+	assert.Equal(t, "key_not_found", reply.Code)
+	status, reply = desktopCall(t, router, http.MethodDelete, strangerPath, desktopTestHost, browser.AccessToken, "")
+	assert.Equal(t, http.StatusNotFound, status)
+	assert.Equal(t, "key_not_found", reply.Code)
+	var remaining int64
+	require.NoError(t, model.DB.Model(&model.Token{}).Where("id = ?", stranger.Id).Count(&remaining).Error)
+	assert.EqualValues(t, 1, remaining)
+
+	status, reply = desktopCall(t, router, http.MethodDelete, "/api/desktop/v2/keys/"+id, desktopTestHost, browser.AccessToken, "")
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	_, err = model.GetTokenByIds(mustAtoi(t, id), user.Id)
+	assert.ErrorIs(t, err, gorm.ErrRecordNotFound)
+}
