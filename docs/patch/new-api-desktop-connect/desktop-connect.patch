+func TestDesktopSessionRefreshRotatesAndSignOutEndsIt(t *testing.T) {
+	router, _, browser := setupDesktopConnect(t)
+	_, exchanged := desktopExchange(t, router, desktopTestHost, desktopIssueCode(t, router, browser))
+	firstRefresh, _ := exchanged.Data["refreshToken"].(string)
+	sessionID, _ := exchanged.Data["sessionId"].(string)
+	refresh := func(token, sid string) (int, desktopTestReply) {
+		return desktopCall(t, router, http.MethodPost, "/api/desktop/v2/sessions/refresh", desktopTestHost, "", `{"refresh_token":"`+token+`","session_id":"`+sid+`"}`)
+	}
+
+	status, reply := refresh(firstRefresh, "another-session")
+	assert.Equal(t, http.StatusUnauthorized, status)
+	assert.Equal(t, "session_expired", reply.Code)
+
+	status, reply = refresh(firstRefresh, sessionID)
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	accessToken, _ := reply.Data["access_token"].(string)
+	secondRefresh, _ := reply.Data["refresh_token"].(string)
+	assert.Equal(t, "Bearer", reply.Data["token_type"])
+	assert.Equal(t, sessionID, reply.Data["session_id"])
+	assert.NotEqual(t, firstRefresh, secondRefresh)
+	assert.Greater(t, reply.Data["refresh_expires_at"], reply.Data["access_expires_at"])
+
+	status, reply = desktopCall(t, router, http.MethodGet, "/api/desktop/v2/account", desktopTestHost, accessToken, "")
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	assert.Equal(t, "desktop-owner", reply.Data["username"])
+	assert.Equal(t, "Owner", reply.Data["displayName"])
+	assert.Equal(t, "USD", reply.Data["currency"])
+	assert.Equal(t, 2.5, reply.Data["balance"])
+
+	status, reply = desktopCall(t, router, http.MethodDelete, "/api/desktop/v2/sessions/current", desktopTestHost, accessToken, "")
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	status, _ = desktopCall(t, router, http.MethodGet, "/api/desktop/v2/account", desktopTestHost, accessToken, "")
+	assert.Equal(t, http.StatusUnauthorized, status)
+	status, reply = refresh(secondRefresh, sessionID)
+	assert.Equal(t, http.StatusUnauthorized, status)
+	assert.Equal(t, "session_expired", reply.Code)
+	// Signing the desktop out leaves the browser signed in.
+	status, _ = desktopCall(t, router, http.MethodGet, "/api/desktop/v2/account", desktopTestHost, browser.AccessToken, "")
+	assert.Equal(t, http.StatusOK, status)
+}
