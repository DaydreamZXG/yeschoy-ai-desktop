+// The desktop-connect contract (v1): a desktop client signs in through the
+// browser with a one-time connect code, then reads the account, plans, keys,
+// usage and notices of the signed-in user. The contract names no product; a
+// client recognises a station by what DesktopBootstrap declares.
+const (
+	desktopConnectService    = "desktop-connect"
+	desktopConnectContractID = "desktop-connect-v1"
+	desktopConnectBasePath   = "/api/desktop/v2"
+	desktopConnectLoginLabel = "desktop"
+
+	desktopConnectCodeTTL = 300 * time.Second
+	// desktopConnectCodeUsed replaces a consumed code until it would have
+	// expired, so a replay is told apart from a code that ran out.
+	desktopConnectCodeUsed = "used"
+	// desktopConnectCodeMemoryLimit bounds the in-process store used without Redis.
+	desktopConnectCodeMemoryLimit = 10000
+
+	desktopUsageWindowDays = 30
+	desktopUsagePageSize   = 100
+)
+
+var (
+	errDesktopConnectCodeExpired = errors.New("connect code expired")
+	errDesktopConnectCodeUsed    = errors.New("connect code already used")
+	errDesktopConnectCodeStore   = errors.New("connect code store unavailable")
+)
+
+// desktopConnectGrant is what a connect code stands for until it is exchanged.
+type desktopConnectGrant struct {
+	UserID      int    `json:"user_id"`
+	AuthVersion int64  `json:"auth_version"`
+	Origin      string `json:"origin"`
+}
+
+type desktopConnectMemoryCode struct {
+	grant     desktopConnectGrant
+	expiresAt time.Time
+	used      bool
+}
+
+var (
+	desktopConnectMemoryCodes     = map[string]*desktopConnectMemoryCode{}
+	desktopConnectMemoryCodesLock sync.Mutex
+)
+
+// desktopConnectConsumeScript hands out a stored grant once: the first caller
+// receives it and leaves a marker behind for the rest of the code's lifetime.
+const desktopConnectConsumeScript = `
+local value = redis.call('GET', KEYS[1])
+if not value then return false end
+if value ~= ARGV[1] then
+  local ttl = redis.call('PTTL', KEYS[1])
+  if ttl > 0 then
+    redis.call('SET', KEYS[1], ARGV[1], 'PX', ttl)
+  else
+    redis.call('DEL', KEYS[1])
+  end
+end
+return value`
+
+func desktopError(c *gin.Context, status int, code string) {
+	c.Header("Cache-Control", "no-store")
+	c.AbortWithStatusJSON(status, gin.H{"success": false, "code": code})
+}
+
+func desktopOK(c *gin.Context, data any) {
+	c.Header("Cache-Control", "no-store")
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": data})
+}
+
+// desktopConnectOrigin is the canonical HTTPS origin the request was sent to.
+// Connect codes are bound to it, so it refuses what a desktop client refuses:
+// an address literal or an explicit port.
+func desktopConnectOrigin(c *gin.Context) (string, bool) {
+	host := strings.ToLower(strings.TrimSpace(c.Request.Host))
+	if host == "" || strings.ContainsAny(host, ":/@?#[]") || net.ParseIP(host) != nil {
+		return "", false
+	}
+	origin, err := common.NormalizeOrigin("https://" + host)
+	return origin, err == nil
+}
+
+func desktopConnectCodeKey(code string) string {
+	sum := sha256.Sum256([]byte(code))
+	return "desktop_connect_code:" + hex.EncodeToString(sum[:])
+}
+
+func storeDesktopConnectCode(code string, grant desktopConnectGrant) error {
+	key := desktopConnectCodeKey(code)
+	if common.RedisEnabled {
+		value, err := common.Marshal(grant)
+		if err != nil {
+			return err
+		}
+		return common.RedisSet(key, string(value), desktopConnectCodeTTL)
+	}
+	now := time.Now()
+	desktopConnectMemoryCodesLock.Lock()
+	defer desktopConnectMemoryCodesLock.Unlock()
+	for stored, entry := range desktopConnectMemoryCodes {
+		if !entry.expiresAt.After(now) {
+			delete(desktopConnectMemoryCodes, stored)
+		}
+	}
+	if len(desktopConnectMemoryCodes) >= desktopConnectCodeMemoryLimit {
+		return errDesktopConnectCodeStore
+	}
+	desktopConnectMemoryCodes[key] = &desktopConnectMemoryCode{grant: grant, expiresAt: now.Add(desktopConnectCodeTTL)}
+	return nil
+}
+
+// consumeDesktopConnectCode returns the grant behind code exactly once.
+func consumeDesktopConnectCode(code string) (desktopConnectGrant, error) {
+	var grant desktopConnectGrant
+	key := desktopConnectCodeKey(code)
+	if common.RedisEnabled {
+		value, err := common.RDB.Eval(context.Background(), desktopConnectConsumeScript, []string{key}, desktopConnectCodeUsed).Text()
+		if errors.Is(err, redis.Nil) {
+			return grant, errDesktopConnectCodeExpired
+		}
+		if err != nil {
+			return grant, errDesktopConnectCodeStore
+		}
+		if value == desktopConnectCodeUsed {
+			return grant, errDesktopConnectCodeUsed
+		}
+		if err := common.UnmarshalJsonStr(value, &grant); err != nil {
+			return grant, errDesktopConnectCodeStore
+		}
+		return grant, nil
+	}
+	desktopConnectMemoryCodesLock.Lock()
+	defer desktopConnectMemoryCodesLock.Unlock()
+	entry, ok := desktopConnectMemoryCodes[key]
+	if !ok || !entry.expiresAt.After(time.Now()) {
+		delete(desktopConnectMemoryCodes, key)
+		return grant, errDesktopConnectCodeExpired
+	}
+	if entry.used {
+		return grant, errDesktopConnectCodeUsed
+	}
+	entry.used = true
+	return entry.grant, nil
+}
