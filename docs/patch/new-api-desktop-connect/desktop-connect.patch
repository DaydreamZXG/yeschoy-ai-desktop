+	console_setting.GetConsoleSetting().AnnouncementsEnabled = false
+	_, reply = desktopCall(t, router, http.MethodGet, "/api/desktop/v2/notices", desktopTestHost, browser.AccessToken, "")
+	assert.Empty(t, reply.Data["notices"])
