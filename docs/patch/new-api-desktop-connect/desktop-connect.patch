+func TestDesktopConnectCodeIsSingleUseOriginBoundAndShortLived(t *testing.T) {
+	router, user, browser := setupDesktopConnect(t)
+
+	// A code opens one desktop session, with the token bundle the client expects.
+	code := desktopIssueCode(t, router, browser)
+	status, reply := desktopExchange(t, router, desktopTestHost, code)
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	assert.Equal(t, "Bearer", reply.Data["tokenType"])
+	accessToken, _ := reply.Data["accessToken"].(string)
+	refreshToken, _ := reply.Data["refreshToken"].(string)
+	sessionID, _ := reply.Data["sessionId"].(string)
+	assert.GreaterOrEqual(t, len(accessToken), 32)
+	assert.GreaterOrEqual(t, len(refreshToken), 32)
+	assert.Greater(t, reply.Data["accessExpiresAt"], float64(time.Now().Unix()))
+	assert.Greater(t, reply.Data["refreshExpiresAt"], reply.Data["accessExpiresAt"])
+	stored, err := model.GetUserSessionBySID(sessionID)
+	require.NoError(t, err)
+	assert.Equal(t, user.Id, stored.UserID)
+	assert.Equal(t, "desktop", stored.LoginMethod)
+
+	// Replay is refused and opens nothing.
+	status, reply = desktopExchange(t, router, desktopTestHost, code)
+	assert.Equal(t, http.StatusBadRequest, status)
+	assert.Equal(t, "connect_code_already_used", reply.Code)
+
+	// A code presented to another origin is refused, and is spent by the attempt.
+	code = desktopIssueCode(t, router, browser)
+	status, reply = desktopExchange(t, router, "other.example", code)
+	assert.Equal(t, http.StatusBadRequest, status)
+	assert.Equal(t, "connect_origin_mismatch", reply.Code)
+	status, reply = desktopExchange(t, router, desktopTestHost, code)
+	assert.Equal(t, http.StatusBadRequest, status)
+	assert.Equal(t, "connect_code_already_used", reply.Code)
+
+	// A code that ran out, or was never issued, is refused.
+	code = desktopIssueCode(t, router, browser)
+	desktopConnectMemoryCodesLock.Lock()
+	desktopConnectMemoryCodes[desktopConnectCodeKey(code)].expiresAt = time.Now().Add(-time.Second)
+	desktopConnectMemoryCodesLock.Unlock()
+	for _, expired := range []string{code, strings.Repeat("a", 43)} {
+		status, reply = desktopExchange(t, router, desktopTestHost, expired)
+		assert.Equal(t, http.StatusBadRequest, status)
+		assert.Equal(t, "connect_code_expired", reply.Code)
+	}
+
+	// The code is asked for by a browser login: not anonymously, not by a desktop session.
+	status, _ = desktopCall(t, router, http.MethodPost, "/api/desktop/v2/connect-codes", desktopTestHost, "", "")
+	assert.Equal(t, http.StatusUnauthorized, status)
+	status, reply = desktopCall(t, router, http.MethodPost, "/api/desktop/v2/connect-codes", desktopTestHost, accessToken, "")
+	assert.Equal(t, http.StatusForbidden, status)
+	assert.Equal(t, "session_required", reply.Code)
+
+	// A code issued before the account's credentials changed opens nothing.
+	code = desktopIssueCode(t, router, browser)
+	require.NoError(t, model.DB.Model(&model.User{}).Where("id = ?", user.Id).Update("auth_version", 2).Error)
+	status, reply = desktopExchange(t, router, desktopTestHost, code)
+	assert.Equal(t, http.StatusBadRequest, status)
+	assert.Equal(t, "connect_code_expired", reply.Code)
+	var desktopSessions int64
+	require.NoError(t, model.DB.Model(&model.UserSession{}).Where("login_method = ?", "desktop").Count(&desktopSessions).Error)
+	assert.EqualValues(t, 1, desktopSessions)
+}
