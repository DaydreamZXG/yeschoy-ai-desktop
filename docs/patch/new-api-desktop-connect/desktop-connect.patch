+func TestDesktopConnectPageCarriesNoCredentialAndLocksItselfDown(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	router := gin.New()
+	router.GET("/desktop/connect", DesktopConnectPage)
+
+	load := func() *httptest.ResponseRecorder {
+		recorder := httptest.NewRecorder()
+		router.ServeHTTP(recorder, httptest.NewRequest(http.MethodGet, "/desktop/connect?auto=1", nil))
+		return recorder
+	}
+	first, second := load(), load()
+	require.Equal(t, http.StatusOK, first.Code)
+
+	assert.Equal(t, "no-store", first.Header().Get("Cache-Control"))
+	assert.Equal(t, "DENY", first.Header().Get("X-Frame-Options"))
+	assert.Equal(t, "nosniff", first.Header().Get("X-Content-Type-Options"))
+	assert.Equal(t, "no-referrer", first.Header().Get("Referrer-Policy"))
+	policy := first.Header().Get("Content-Security-Policy")
+	assert.Contains(t, policy, "default-src 'none'")
+	assert.Contains(t, policy, "connect-src 'self'")
+	assert.Contains(t, policy, "frame-ancestors 'none'")
+	assert.NotContains(t, policy, "script-src 'unsafe-inline'")
+	assert.NotEqual(t, policy, second.Header().Get("Content-Security-Policy"), "the script nonce is new on every load")
+
+	page := first.Body.String()
+	assert.NotContains(t, page, "{{")
+	assert.Contains(t, page, "yeschoy://connect?origin=")
+	// The page keeps the access token in memory only.
+	assert.NotContains(t, page, "localStorage")
+	assert.NotContains(t, page, "sessionStorage")
+}
