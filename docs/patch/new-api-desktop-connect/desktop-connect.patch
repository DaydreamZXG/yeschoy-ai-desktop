+func desktopIssueCode(t *testing.T, router http.Handler, browser *service.AuthBundle) string {
+	t.Helper()
+	status, reply := desktopCall(t, router, http.MethodPost, "/api/desktop/v2/connect-codes", desktopTestHost, browser.AccessToken, "")
+	require.Equal(t, http.StatusOK, status, reply.Code)
+	code, _ := reply.Data["code"].(string)
+	require.GreaterOrEqual(t, len(code), 32)
+	assert.Equal(t, "https://"+desktopTestHost, reply.Data["origin"])
+	assert.LessOrEqual(t, reply.Data["ttlSeconds"], float64(300))
+	return code
+}
