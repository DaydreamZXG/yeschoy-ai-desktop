{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv/public
	@msix path *.msix
	header @msix Content-Type application/vnd.ms-appx
	@dmg path *.dmg
	header @dmg Content-Type application/x-apple-diskimage
	@updateArtifact path /updates/releases/*
	header @updateArtifact Cache-Control "public, max-age=31536000, immutable"
	@mutableResponse not path /updates/releases/*
	header @mutableResponse Cache-Control no-store
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# route preserves guard ordering ahead of terminal handle blocks.
	route {
		@unsafe not method GET HEAD
		respond @unsafe "Method not allowed" 405
		@traversal expression `{http.request.orig_uri}.matches('(?i)(^|/|%2f)([.]|%2e){1,2}(/|%2f|[?]|$)')`
		respond @traversal "Not found" 404
		@hidden path_regexp hidden (^|/)\.
		respond @hidden "Not found" 404
		@directory path_regexp directory ^/(releases|apps|updates/releases)(/.*)?/$
		respond @directory "Not found" 404

		handle / {
			respond "野菜API 下载与更新服务。可用安装包以下载清单为准；自动更新以已发布频道为准。" 200
		}
		handle /health.json {
			file_server
		}
		# Legacy builds cannot identify their distribution. Never offer an
		# official or partner payload here, even if an old JSON file remains.
		handle /updates/stable.json {
			respond "" 204
		}
		handle /updates/beta.json {
			respond "" 204
		}
		@variantManifest {
			path /updates/official/stable.json /updates/partner/stable.json
			file {path}
		}
		handle @variantManifest {
			file_server
		}
		@missingVariantManifest path /updates/official/stable.json /updates/partner/stable.json
		handle @missingVariantManifest {
			respond "" 204
		}
		handle /checks/download-test.txt {
			file_server
		}
		handle /releases/* {
			file_server {
				hide .*
			}
		}
		handle /apps/* {
			file_server {
				hide .*
			}
		}
		handle /updates/releases/* {
			file_server {
				hide .*
			}
		}
		handle {
			respond "Not found" 404
		}
	}
}
