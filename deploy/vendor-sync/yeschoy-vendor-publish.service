[Unit]
Description=Publish verified vendor installer candidates
After=yeschoy-vendor-sync.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/yeschoy-vendor-sync
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/yeschoy-vendor-sync/publish_pending.py
StateDirectory=yeschoy-vendor-publish
StateDirectoryMode=0700
TimeoutStartSec=1h
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/yeschoy-download/public /var/lib/private/yeschoy-vendor-sync /var/lib/yeschoy-vendor-publish
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

