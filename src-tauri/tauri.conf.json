{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "野菜API",
  "version": "0.4.14",
  "identifier": "com.yeschoy.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "野菜API",
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 640,
        "visible": true,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3NDk0OEFCNTY3RjhGMTkKUldRWmozOVdxMGhKUno2OHRScjRYaVlXVVUyek9uSHNNcDdWV0NwTW9kQndWM0ZJczlxa2J4L0YK",
      "endpoints": [
        "https://ergou.qzz.io/updates/stable.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
